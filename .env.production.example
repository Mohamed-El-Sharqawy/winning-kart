# Single self-hosted Postgres URL (no pooler/direct split in production).
# From inside the containers the host is the VPS docker bridge, e.g.:
#   postgresql://winningkart:PASSWORD@172.17.0.1:5432/winningkart
DATABASE_URL=""

# AES-256-GCM master key, 32 bytes hex (64 hex chars). Generate with:
#   bun -e "console.log(crypto.randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# JWT signing secret. Generate the same way:
#   bun -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_SECRET=""

# API
PORT=3000
NODE_ENV=production

# Hourly ad account sync is ON when unset or any value other than "off".
# Set WK_SYNC_CRON=off to disable the scheduler.
WK_SYNC_CRON=

# API: comma-separated dashboard origins allowed by CORS (credentials included).
# Set on the api resource to the dashboard's public origin, e.g.:
#   CORS_ORIGINS="https://dashboard.example.com"
CORS_ORIGINS=

# Dashboard (build-time): public api base URL the SPA calls directly, e.g.:
#   VITE_API_URL="https://api.example.com"
# When empty, the SPA stays same-origin and the dashboard nginx proxies /api.
VITE_API_URL=

# Knob	Default	What it controls
# WK_META_USAGE_SOFT_LIMIT	70	% of Meta quota where we start slowing down between calls
# WK_META_SLOWDOWN_MS	400	how long we sleep between calls once over the soft limit
# WK_SYNC_WINDOW_DAYS	30	how many days of data a routine sync refreshes
# WK_DECORATE_MAX	200	max creatives decorated per sync run (rest finish next run)
# WK_QUEUE_MIN_CALL_INTERVAL_MS	300	minimum gap between any two Meta calls in the background queue