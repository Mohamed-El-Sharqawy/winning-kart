# Database (dev: Neon — pooling URL for the app, direct URL for drizzle migrations; prod: single self-hosted Postgres URL)
DATABASE_URL=""
DIRECT_DATABASE_URL=""

# Master encryption key for AES-256-GCM (operator-held, 32 bytes hex). NEVER commit real values.
ENCRYPTION_KEY=""

# JWT
JWT_SECRET="" # required, at least 16 characters

# API
PORT=3000

# Knob	Default	What it controls
# WK_META_USAGE_SOFT_LIMIT	70	% of Meta quota where we start slowing down between calls
# WK_META_SLOWDOWN_MS	400	how long we sleep between calls once over the soft limit
# WK_SYNC_WINDOW_DAYS	30	how many days of data a routine sync refreshes
# WK_QUEUE_MIN_CALL_INTERVAL_MS	300	minimum gap between any two Meta calls in the background queue
# WK_DELTA_PER_ENTITY_MAX	25	max per-entity fetches in one sync before a full edge pull
# WK_MEDIA_URL_TTL_DAYS	7	media CDN URL age (days) before it is re-resolved on demand (1-30)