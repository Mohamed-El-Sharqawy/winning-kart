  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/bun": "^1.2.0",
    "@types/node": "^26.2.0",
    "@wk/config": "workspace:*",
    "typescript": "^5.7.0"
  }
}
