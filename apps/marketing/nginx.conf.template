server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location /_astro/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location = /health {
        return 200 'ok';
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
