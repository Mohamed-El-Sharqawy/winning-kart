---
import BaseLayout from "./BaseLayout.astro";
import type { LegalDoc } from "../content/types";

interface Props {
  doc: LegalDoc;
}

const { doc } = Astro.props;
---

<BaseLayout title={doc.title} description={doc.description} path={doc.path}>
  <article class="legal">
    <header>
      <h1>{doc.title}</h1>
      <p class="updated">Last updated: {doc.updated}</p>
    </header>
    {
      doc.sections.map((section) => (
        <section>
          <h2>{section.heading}</h2>
          {section.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </section>
      ))
    }
  </article>
</BaseLayout>
